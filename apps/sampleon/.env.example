# SAMPLEON settings. Only DATABASE_URL and the SUPPLY360 connection are needed to start.
DATABASE_URL=postgresql://sampleon:sampleon@localhost:5432/sampleon
PORT=4600
# Public address: survey-card links (/go/{token}) and browser returns (/r/{status}) use it.
PUBLIC_URL=http://localhost:4600

# SUPPLY360 eligibility & delivery API. SAMPLEON signs as SUPPLY360_CLIENT_ID with SUPPLY360_SECRET.
# Register the same secret for client "supply360" (admin.js client ...) so SUPPLY360 can call back.
SUPPLY360_URL=http://localhost:4000
SUPPLY360_CLIENT_ID=sampleon
SUPPLY360_SECRET=

# Survey-host client used when a request does not name survey.hostId.
DEFAULT_SURVEY_HOST=zapx

# Feasibility and invitations
DEFAULT_RESPONSE_RATE=0.12
FATIGUE_MAX_INVITES=3
FATIGUE_WINDOW_DAYS=7
ACTIVE_WITHIN_DAYS=90
MAX_BATCH_SIZE=5000
AUTO_BATCH_INTERVAL_MINUTES=60
MAX_ROUTE_HOPS=3
# Where a respondent lands when no other survey fits (optional).
PANEL_END_URL=

# Background worker (batches, outbox). WORKER_INLINE=false runs no worker in this process.
WORKER_INTERVAL_MS=2000

# Natural-language targeting: rules always; Claude when configured. Its drafts must pass the same checks.
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
